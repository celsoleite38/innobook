# .env.example — MODELO para produção (VPS)
# Copie para a VPS como `.env` e preencha APENAS os valores marcados como
# "COLOQUE AQUI". Nunca suba o .env real para o git (ele já está no .gitignore).

# --- Segurança Django ---
# Gere um novo com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=COLOQUE_AQUI_UM_SECRET_KEY_LONGO
DEBUG=False
# Domínios que podem acessar o site (separados por vírgula)
ALLOWED_HOSTS=loja.editoraorange.com.br,191.252.191.208
CSRF_TRUSTED_ORIGINS=https://loja.editoraorange.com.br

# --- Asaas (pagamentos) ---
# sandbox | production
ASAAS_ENV=sandbox
ASAAS_API_KEY=COLOQUE_AQUI_A_CHAVE_ASAAS
ASAAS_WEBHOOK_TOKEN=COLOQUE_AQUI_O_TOKEN_DE_VERIFICACAO_DO_WEBHOOK

# --- Melhor Envios (fretes) ---
# 1) Sandbox: https://app-sandbox.melhorenvio.com.br | Produção: https://melhorenvio.com.br
# 2) Menu: Integrações → Área Dev → "Cadastrar Aplicativo"
# 3) Callback deve ser IGUAL ao ME_REDIRECT_URI abaixo
# 4) Cole o Client ID e o Secret nas linhas abaixo
ME_ENV=sandbox
ME_CLIENT_ID=COLOQUE_AQUI_O_CLIENT_ID
ME_CLIENT_SECRET=COLOQUE_AQUI_O_CLIENT_SECRET
ME_REDIRECT_URI=https://loja.editoraorange.com.br/delivery/envios/oauth/callback/
# Deixe vazio: o sistema usa o ME_CLIENT_SECRET como token do webhook
ME_WEBHOOK_TOKEN=

# --- Banco de dados (PostgreSQL na VPS) ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=book_orange_db
DB_USER=book_orange_user
DB_PASSWORD=COLOQUE_AQUI_A_SENHA_DO_BANCO
DB_HOST=localhost
DB_PORT=5432

# --- Segurança HTTP (obrigatório True atrás de nginx com HTTPS) ---
USE_PROXY_SSL=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# --- URL pública do site (usada em e-mails e OAuth) ---
SITE_URL=https://loja.editoraorange.com.br

# --- Email (SMTP Titan) ---
# As configurações de e-mail vivem em core/settings.py; aqui ficam apenas os
# valores de conexão. NÃO adicione EMAIL_TIMEOUT aqui (o default é 30s).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.titan.email
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=meulivro@editoraorange.com.br
EMAIL_HOST_PASSWORD=COLOQUE_AQUI_A_SENHA_DO_EMAIL
DEFAULT_FROM_EMAIL=Editora Orange <meulivro@editoraorange.com.br>
